#!/usr/bin/env bash
set -e

#  compile test:
#  test-main.o : this is compiled in bootstrap.init and can be linked with all catch tests
#  -I ../      : indicates that there are files in the parent directory that we '#include' in our test (these are the
#                files that were submitted by the student).
#  -o test.exe : name the compiled executable 'test.exe'

# src code references
source_code=(
    "test_3.cpp"
)
if [[ -n "is_equation_balanced.cpp" && -f "../../src/is_equation_balanced.cpp" ]]; then
    source_code+=("../../src/is_equation_balanced.cpp")
fi

# compilation command
g++ -D AUTOGRADE -std=c++23 "${source_code[@]}" ../../test-main.o -I ../../ -I ../../include -I /autograder/source/tests/include -I /autograder/submission -I /autograder/submission/include -I /usr/include/catch2 -o test.exe -pthread

#  execute the test
./test.exe
