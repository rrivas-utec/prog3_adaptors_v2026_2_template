# CLion remote docker environment (How to build docker container, run and stop it)
#
# Build and run:
#   docker build -t repository:tag .
#   docker run -d --cap-add sys_ptrace -p 127.0.0.1:2222:22 --name container_name image_name
#   ssh-keygen -f "$HOME/.ssh/known_hosts" -R "[localhost]:2222"
#
# stop:
#   docker stop container_name
#
# ssh credentials (test user):
#   user@password

# Keep the local validation image aligned with the Gradescope Ubuntu 22 runtime.
# Update this reference only together with the integration test evidence.
FROM gradescope/auto-builds:ubuntu-22.04

RUN apt-get update && \
    apt-get install -y software-properties-common ca-certificates gnupg wget && \
    add-apt-repository -y ppa:ubuntu-toolchain-r/test && \
    apt-get update && \
    apt-get install -y \
        gcc-14 g++-14 catch2 cppcheck libeigen3-dev valgrind \
        python3 python3-pip python-is-python3 dos2unix jq \
        clang clang-tidy clang-tools clang-format && \
    if [ -x /usr/bin/gcov-14 ]; then \
      update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 140 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-14 \
        --slave /usr/bin/gcov gcov /usr/bin/gcov-14; \
    else \
      update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 140 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-14; \
    fi && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /autograder/

CMD ["/usr/sbin/sshd", "-D", "-e", "-f", "/etc/ssh/sshd_config_test_clion"]
